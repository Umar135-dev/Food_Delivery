<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/register_bg"
    tools:context=".activities.MainActivity">

    <!-- Header: title on the left, cart + profile on the right -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="15dp"
        android:paddingBottom="20dp">

        <!-- Left: title and subtitle (takes all the free width) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textViewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/food_menu"
                android:textColor="@color/gold"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textViewSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="What would you like to eat today?"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Cart button (left of profile) with item-count badge -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="6dp">

            <ImageView
                android:id="@+id/navCart"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_gravity="center"
                android:clickable="true"
                android:contentDescription="View Cart"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_cart" />

            <TextView
                android:id="@+id/tvCartBadge"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:background="@drawable/cart_badge_bg"
                android:gravity="center"
                android:minWidth="18dp"
                android:paddingHorizontal="5dp"
                android:text="0"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Profile icon -->
        <ImageView
            android:id="@+id/ivProfile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/profile_icon_bg"
            android:clickable="true"
            android:contentDescription="Profile"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_profile" />
    </LinearLayout>

    <!-- White rounded content card (fragments load here).
         Bottom padding keeps content above the floating nav bar. -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerLayout"
        android:background="@drawable/signupform_bg"
        android:paddingHorizontal="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="96dp" />

    <!-- Bottom navigation: pinned to the bottom, full width -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="0dp"
        android:background="@drawable/bottom_nav_bg"
        android:clipToOutline="true"
        android:elevation="8dp"
        app:itemActiveIndicatorStyle="@style/NavPillIndicator"
        app:itemIconSize="22dp"
        app:itemIconTint="@color/nav_item_color"
        app:itemPaddingBottom="0dp"
        app:itemPaddingTop="5dp"
        app:itemTextAppearanceActive="@style/CustomMenuTextAppearance"
        app:itemTextAppearanceInactive="@style/CustomMenuTextAppearance"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />
</RelativeLayout>